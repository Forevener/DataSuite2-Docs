// The café – the running example of the concepts section (docs/en/concepts/). One row per loyalty
// member of a two-branch café, exported after a menu change: what the till knows about the member
// (average spend per visit and visit count, in the eight weeks before and after the change) and
// what a short satisfaction survey sent afterwards asked them. Generated by the exam builder's
// authored spec format (docs/en/exam-spec-reference.md):
//
//   app-gen --spec docs/examples/cafe.json5 --name cafe --authored
//
// The name is the seed, so `--name cafe` reproduces the dataset exactly; cafe.csv is that dataset
// written the way the app exports it (Papa.unparse: a header row, the generator's column order,
// a blank cell for a missing value) with LF line endings and no byte-order mark. Every number a
// concept page quotes comes from that file, so a change to anything here – the name included – is
// a change to the prose. See docs/en/concepts/guide-data.md for the codebook.
// cafe.ru.csv is this dataset with its header translated and `recommend`'s yes / no written
// «рекомендует» / «не рекомендует», every other value identical – the Russian docs quote it, so a
// change here is a change to both files. Its labels sort as the English ones do (no < yes as
// «не рекомендует» < «рекомендует»; the recoded branches Riverside < Station as «Набережная» <
// «Привокзальная»), since the app orders text levels alphabetically and every signed two-group
// quantity would flip otherwise.
//
// Three flaws are deliberate, so the guide can walk the reader through noticing them:
//   - `branch` is coded 1 / 2 (1 = Riverside, 2 = Station), so the app types it as a number –
//     the reader recodes it to its names and it becomes categorical
//   - `age` holds 999 for members who declined to give it (about 3 %) – a sentinel the reader
//     declares as a missing code before the column is used
//   - one member's `spend_after` is a catering order for an office party, averaged into their
//     visits – a real value that is not what the question means, which the reader filters out
// `overall` and `wait` carry a few genuinely blank cells, so pairwise and listwise deletion differ.
//
// Structure: two correlated satisfaction factors (Food, Service) with three items each, `slow`
// reverse-keyed; `overall` and `recommend` load on both; `wait` loads negatively on Service.
// Spend and Loyalty carry the paired till columns, so before and after correlate within a member.
// Station (branch 2) spends more, is served slower and is more heterogeneous; older members spend
// more and visit more often.
{
	n: 200,
	factors: ["Food", "Service", "Spend", "Loyalty"],
	phi: {
		"Food~Service": 0.5,
		"Food~Spend": 0.4,
		"Service~Spend": 0.25,
		"Food~Loyalty": 0.25,
		"Service~Loyalty": 0.3,
		"Spend~Loyalty": 0.15,
	},
	// The survey items: 1 = strongly disagree … 5 = strongly agree, skewed towards agreement
	defaults: { family: "ordinal", params: [-1.8, -1.0, -0.2, 0.8] },
	variables: {
		// "The food tasted good" / "The ingredients were fresh" / "The food was good value"
		taste: { load: "Food*0.75", params: [-1.9, -1.1, -0.3, 0.7] },
		fresh: { load: "Food*0.70" },
		value: { load: "Food*0.60", params: [-1.6, -0.8, 0.0, 0.9] },
		// "The staff were friendly" / "My order came quickly" / "The service was slow" (reverse-keyed)
		friendly: { load: "Service*0.75", params: [-2.0, -1.3, -0.5, 0.5] },
		quick: { load: "Service*0.65", params: [-1.7, -0.9, -0.1, 0.8] },
		slow: { load: "Service*-0.60", params: [-0.6, 0.2, 1.0, 1.8] },
		// "Overall, how satisfied are you with the café?" 0–10; a few left it blank
		overall: { load: "Food*0.55 + Service*0.45", family: "normal", params: [7.5, 1.6], min: 0, max: 10, round: 0, missing: 0.04 },
		// "Would you recommend us to a friend?"
		recommend: { load: "Food*0.5 + Service*0.45", family: "bernoulli", params: [0.72], labels: ["no", "yes"] },
		// Minutes waited for the order at the last visit, right-skewed; a few left it blank
		wait: { load: "Service*-0.55", family: "gamma", params: [4, 0.8], round: 1, missing: 0.06 },
		// Average spend per visit, in currency units, eight weeks before and after the menu change.
		// The after column's second mixture component is the catering order: its weight is tuned so
		// that exactly one member – the highest latent spender – lands on it (Station's wider spread
		// fattens the latent's tail, so the weight is far below 1/200).
		spend_before: { load: "Spend*0.80", family: "normal", params: [8.6, 2.8], min: 1.5, round: 2 },
		spend_after: { load: "Spend*0.80", family: "mixture", params: [0.99994, 9.5, 3.0, 0.00006, 64, 2], min: 1.5, round: 2 },
		// Visits in the same two eight-week windows: counts, right-skewed
		visits_before: { load: "Loyalty*0.85", family: "negbin", params: [6, 4] },
		visits_after: { load: "Loyalty*0.85", family: "negbin", params: [6.8, 4] },
	},
	groups: {
		// Coded, not named – the first flaw. Station is busier: bigger spend, slower service, wider spread
		branch: { levels: ["1", "2"], effect: "Spend*0.4 + Service*-0.35", spread: [1, 1.4] },
	},
	predictors: {
		// Two age groups – students and office workers – plus the 999 sentinel, the second flaw: a
		// third component far above the ceiling, so `max` pins every draw from it at exactly 999
		// (a narrow component at 999 itself would fall between the generator's quantile grid points)
		age: { family: "mixture", params: [0.58, 31, 6, 0.39, 47, 9, 0.03, 1500, 30], min: 18, max: 999, round: 0, effect: "Spend*0.5 + Loyalty*0.4" },
	},
}
